{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "markdown-editor",
  "version": "0.1.0",
  "identifier": "com.github.al-ula.markdown-editor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "markdown-editor",
        "width": 800,
        "height": 600,
        "minWidth": 400,
        "minHeight": 360,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      },
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
